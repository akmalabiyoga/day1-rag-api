@host = http://localhost:3000
@cvFolder = /home/dedoyxp/kode/cv_test
@cvFile = cv_16_Senior_Data_Engineer.pdf
@cvFilePath = {{cvFolder}}/{{cvFile}}

### Health-style check using existing search endpoint
POST {{host}}/api/cv/search
Content-Type: application/json

{
	"query": "data engineering",
	"threshold": 1.0
}

### Ask question from stored CV chunks
POST {{host}}/api/cv/ask
Content-Type: application/json

{
	"question": "What are this candidate's strongest technical skills?"
}

### Upload PDF CV (update file path first)
POST {{host}}/api/cv/upload
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="cv"; filename="{{cvFile}}"
Content-Type: application/pdf

< {{cvFilePath}}
--boundary--
